# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env && docker compose up --build

# --- required -----------------------------------------------------------------
# Left EMPTY on purpose. Compose's `:?` guard only fires on an unset or empty value, so
# a placeholder like `sk-ant-...` would let the stack boot and then fail at the first
# analysis — far from the cause. Fill these in before `docker compose up`.
POSTGRES_PASSWORD=
ANTHROPIC_API_KEY=

# --- renders ------------------------------------------------------------------
# Without a token, renders fall back to the free provider and the client report
# captions them as drafts. FLUX.1-Krea-dev costs ~$0.025 per render (~$0.075/report).
HUGGINGFACE_API_TOKEN=
# Drop to fal-ai/flux/schnell ($0.003/megapixel) when volume matters more than fidelity.
MEYRAKI_FLUX_MODEL=fal-ai/flux/krea
# Optional: the contracted image provider, preferred whenever its key has quota.
GEMINI_API_KEY=

# --- cost ---------------------------------------------------------------------
# Per-analysis model-spend ceiling. A measured Cleo-class report costs ~$0.22, so the
# default carries roughly 7x headroom. The run stops rather than overspending.
MEYRAKI_ANALYSIS_BUDGET_USD=1.50

# --- serving ------------------------------------------------------------------
# The URL the BROWSER uses to reach the API. Inlined into the web bundle at build time,
# so changing it requires `docker compose build web`, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:8000
MEYRAKI_WEB_ORIGINS=http://localhost:3000

# Set BOTH to 1 behind a TLS-terminating proxy. Without MEYRAKI_HTTPS the session cookie
# ships without Secure; without MEYRAKI_TRUST_PROXY the rate limiter sees the proxy's IP
# as every client and one visitor can exhaust everyone's quota.
MEYRAKI_HTTPS=0
MEYRAKI_TRUST_PROXY=0
