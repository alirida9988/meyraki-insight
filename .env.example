# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env && docker compose up --build

# --- required -----------------------------------------------------------------
# Left EMPTY on purpose. Compose's `:?` guard only fires on an unset or empty value, so
# a placeholder like `sk-ant-...` would let the stack boot and then fail at the first
# analysis — far from the cause. Fill these in before `docker compose up`.
POSTGRES_PASSWORD=
ANTHROPIC_API_KEY=

# --- renders ------------------------------------------------------------------
# Without a token, renders fall back to the free provider and the client report
# captions them as drafts. FLUX.1-Krea-dev costs ~$0.025 per render (~$0.075/report).
HUGGINGFACE_API_TOKEN=
# Drop to fal-ai/flux/schnell ($0.003/megapixel) when volume matters more than fidelity.
MEYRAKI_FLUX_MODEL=fal-ai/flux/krea
# Optional: the contracted image provider, preferred whenever its key has quota.
GEMINI_API_KEY=

# --- cost ---------------------------------------------------------------------
# Per-analysis model-spend ceiling. A measured Cleo-class report costs ~$0.22, so the
# default carries roughly 7x headroom. The run stops rather than overspending.
MEYRAKI_ANALYSIS_BUDGET_USD=1.50

# --- sharing -------------------------------------------------------------------
# Signs expiring links to a client-facing report. Leave EMPTY and sharing is disabled;
# it is never derived from anything else, because a guessable signing key would let
# anyone mint a link to any report. Rotating it invalidates every link already sent.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MEYRAKI_SHARE_SECRET=

# --- serving ------------------------------------------------------------------
# The URL the BROWSER uses to reach the API. Inlined into the web bundle at build time,
# so changing it requires `docker compose build web`, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:8000
MEYRAKI_WEB_ORIGINS=http://localhost:3000

# Set BOTH to 1 behind a TLS-terminating proxy. Without MEYRAKI_HTTPS the session cookie
# ships without Secure; without MEYRAKI_TRUST_PROXY the rate limiter sees the proxy's IP
# as every client and one visitor can exhaust everyone's quota.
MEYRAKI_HTTPS=0
MEYRAKI_TRUST_PROXY=0

# --- production (docker-compose.prod.yml) ---------------------------------------
# Only needed for the production overlay, which puts Caddy in front and terminates TLS:
#   GIT_SHA=$(git rev-parse --short HEAD) \
#     docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# The overlay sets MEYRAKI_HTTPS, MEYRAKI_TRUST_PROXY, MEYRAKI_WEB_ORIGINS and
# NEXT_PUBLIC_API_URL for you from these two names — do not set them by hand as well.
#
# BOTH names must share a registrable domain (app.meyraki.com + api.meyraki.com, NOT
# meyraki-app.com + meyraki-api.com). The session cookie is SameSite=Lax, which browsers
# judge per site rather than per origin: subdomains of one domain are same-site and the
# cookie is sent, two unrelated domains are not, and every signed-in request would arrive
# without a session while looking, from the logs, like a login problem.
APP_DOMAIN=
API_DOMAIN=
# Let's Encrypt sends certificate expiry and problem notices here. A real mailbox.
ACME_EMAIL=

# Stamped onto every analysis and reported by /health, so a delivered report can be traced
# back to the code that produced it. Unset is tolerated and records "unknown".
GIT_SHA=
